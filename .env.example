# CampusMind AI Environment Configuration
PROJECT_NAME="CampusMind AI"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="campusmind-super-secure-secret-key-change-in-production-2025"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="campusmind2025"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
# Supported: gemini, mock (local synthesis fallback)
LLM_PROVIDER="gemini"
# Set your Google Gemini API key below to enable live Gemini generation:
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Embedding Provider Configuration
# Supported: tfidf (fast built-in), gemini
EMBEDDING_PROVIDER="tfidf"

# RAG & Retrieval Parameters
SIMILARITY_THRESHOLD=0.13
TOP_K_RETRIEVAL=4
CHUNK_SIZE=650
CHUNK_OVERLAP=120

# Database
DATABASE_URL="sqlite:///./data/campusmind.db"

# Storage Directories
DOCUMENTS_DIR="./data/documents"
VECTOR_STORE_DIR="./data/vector_store"
EVALUATION_DATASET_PATH="./data/evaluation/dataset.json"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
