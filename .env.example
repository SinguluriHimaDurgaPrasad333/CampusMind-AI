# CampusAI Configuration Environment Variables

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_RESULTS=4
COSINE_DISTANCE_THRESHOLD=0.75

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=campusai_knowledge

# LLM Operating Mode: "auto", "ollama", "gemini", or "extractive"
LLM_MODE=auto

# Local Ollama Configuration (Free, Offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Cloud API LLM (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Admin Authentication (SHA-256 Hash of Password)
# Default password below is 'admin123'
ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9
